# Meson cross file: build DXVK for Android arm64 with the NDK clang toolchain.
# Generated by cmake/dx8.cmake from the compiler CMake's Android toolchain selected.

[binaries]
c = '@NDK_BIN_DIR@/aarch64-linux-android@ANDROID_API_LEVEL@-clang'
cpp = '@NDK_BIN_DIR@/aarch64-linux-android@ANDROID_API_LEVEL@-clang++'
ar = '@NDK_BIN_DIR@/llvm-ar'
strip = '@NDK_BIN_DIR@/llvm-strip'
pkg-config = 'pkg-config'

[host_machine]
system = 'android'
cpu_family = 'aarch64'
cpu = 'armv8-a'
endian = 'little'

[properties]
needs_exe_wrapper = true

[built-in options]
# VK_ENABLE_BETA_EXTENSIONS: the fork references VK_KHR_portability_subset (vulkan_beta.h).
c_args = ['-fPIC', '-DVK_ENABLE_BETA_EXTENSIONS']
cpp_args = ['-fPIC', '-DVK_ENABLE_BETA_EXTENSIONS']
# Static libc++: each native library carries its own copy, so no C++ heap objects
# ever cross a library boundary (DXVK talks to the game through COM interfaces only).
cpp_link_args = ['-Wl,-z,max-page-size=16384', '-static-libstdc++']
c_link_args = ['-Wl,-z,max-page-size=16384']
